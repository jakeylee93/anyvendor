# AnyVendor business backend. Names only; set real values in Vercel (Preview first).
# Without the Supabase pair the /business area runs as a clearly labelled demo.

# Dedicated AnyVendor Supabase project (never the anyOS project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exact public base URL registered with OAuth providers and used for Stripe returns
APP_URL=

# Security: 32-byte base64 key for token encryption; random secrets for OAuth state and cron
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
CRON_SECRET=
# Shared with bespoke vendor sites that expose POST /api/revalidate (optional)
SITE_REVALIDATE_SECRET=

# Stripe (test mode, isolated AnyVendor products/prices in the chosen account)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional fixed monthly price ids (otherwise prices are found by lookup key anyvendor_<plan>_monthly|annual)
# STRIPE_PRICE_LISTING=
# STRIPE_PRICE_WEBSITE=
# STRIPE_PRICE_MARKETING=
# STRIPE_PRICE_SOCIAL=
# STRIPE_PRICE_AI=

# Businesses connect their OWN accounts through AnyVendor's apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
